DATABASE_URL=sqlite:///./jsvoc_dev.db
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAMES=chuyu111

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=180

# Optional OpenAI Responses API web search for AI Chat.
# Leave blank to reuse LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=
WEB_SEARCH_CONTEXT_SIZE=medium

# Hot video search can use a configured OpenCLI command first, then fall back to
# LLM web search when HOT_VIDEO_SEARCH_PROVIDER=auto and the command is empty.
# Placeholders are shell-quoted: {query}, {keyword}, {platform}, {focus}, {count}, {project}.
HOT_VIDEO_SEARCH_PROVIDER=auto
OPENCLI_HOT_VIDEO_SEARCH_COMMAND=
OPENCLI_SEARCH_TIMEOUT_SECONDS=30

ACCOUNT_PACKAGE_MODEL=deepseek-v4-flash
EXECUTION_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_TOPICS_MODEL=deepseek-v4-flash
DEEPSEEK_ACCOUNT_PACKAGE_MODEL=deepseek-v4-flash

# Volcengine Ark / Seedance video generation.
# Use official model names in the app; do not use ep-m-* endpoint ids.
ARK_API_KEY=
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_BASE_URL=https://ark.cn-beijing.volces.com
VIDEO_GENERATION_MODEL=seedance-2.0
VIDEO_GENERATION_SEEDANCE_2_ENDPOINT=doubao-seedance-2-0-260128
VIDEO_GENERATION_SEEDANCE_FAST_ENDPOINT=doubao-seedance-2-0-fast-260128
VIDEO_GENERATION_ENABLED_MODELS=seedance-2.0,seedance-2.0-fast
VIDEO_GENERATION_TIMEOUT_SECONDS=300

# Alibaba Cloud OSS private bucket. Backend signs temporary URLs for frontend access.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=jsvoc2
OSS_URL_EXPIRE_SECONDS=600

# DataEye OpenAI-compatible channel example:
# LLM_PROVIDER=dataeye
# LLM_BASE_URL=https://platform.shuyanai.com
# LLM_API_KEY=your-dataeye-api-key
# LLM_MODEL=deepseek-v4-flash

# Moyu OpenAI-compatible channel example:
# LLM_PROVIDER=moyu
# LLM_BASE_URL=https://www.moyu.info/v1/chat/completions
# LLM_API_KEY=your-moyu-api-key
# LLM_MODEL=deepseek-v4-flash
# ACCOUNT_PACKAGE_MODEL=deepseek-v4-flash
# EXECUTION_PLAN_MODEL=deepseek-v4-flash

VITE_API_BASE_URL=/

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=short_video_ops

# Docker image overrides. These values are helpful on servers where Docker Hub
# access is unstable. Replace with official images if your network can pull them.
POSTGRES_IMAGE=docker.1ms.run/library/postgres:16
PYTHON_IMAGE=docker.1ms.run/library/python:3.11-slim
NODE_IMAGE=docker.1ms.run/library/node:20-alpine
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
